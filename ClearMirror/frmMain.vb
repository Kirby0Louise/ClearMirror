Imports Microsoft.Win32
Imports System.IO
Public Class frmMain
    Dim results As New List(Of GPUInfo)
    Dim AWvsSAOSettingsIni As String = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData) + "\Accel World vs. Sword Art Online\OptionConfig.ini"
    Dim lines As String()
    Private Sub frmMain_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        If Not File.Exists(AWvsSAOSettingsIni) Then
            MsgBox("Initial settings file not generated.  Please run the official launcher at least once." + vbNewLine + "(WIP, to be resolved in later releases)")
            Environment.Exit(0)
        End If

        If True Then
            Using GPUPrefsKey = Registry.CurrentUser.OpenSubKey("SOFTWARE\Microsoft\DirectX\UserGpuPreferences")
                Dim AWvsSAOValue As Object = GPUPrefsKey.GetValue("C:\Program Files (x86)\Steam\steamapps\common\REK\AWVSSAO.exe")
                If AWvsSAOValue Is Nothing Then
                    MsgBox("Initial GPU preference settings have not been generated by Windows.  Please run the game at least once.")
                    Environment.Exit(0)
                End If
            End Using
        End If

        casoAndOSHeuristic()
        populateGPUs()
        readSettings()
    End Sub

    Sub casoandOSHeuristic()
        'Best current heuristic
        'app.manifest was modified to get it to detect newer versions of Windows
        'This might break on Win 12+
        Dim osVer As Version = Environment.OSVersion.Version
        If osVer.Major >= 10 And osVer.Build >= 22000 Then
            tsslCASOSupport.Text = "Your system supports CASO (or at least our heuristic thinks it does)"
        Else
            tsslCASOSupport.Text = "Your system does NOT support CASO (or at least our heuristic thinks it doesn't).  Performance may be degraded when using hybrid graphics"
        End If

        'Warn about Proton/Wine
        'null if doesn't exist (real Windows)
        Dim testLinux As String = Environment.GetEnvironmentVariable("STEAM_COMPAT_DATA_PATH")
        If testLinux IsNot Nothing Then
            MsgBox("We think we're running on Linux/SteamOS." + vbNewLine + vbNewLine + "Note that ClearMirror requires integration with the Windows registry and relies on Windows' hybrid graphics pipeline." + vbNewLine + "You may continue, but this is experimental/unsupported.", MsgBoxStyle.OkOnly + MsgBoxStyle.Exclamation, "Linux/SteamOS Detected")
            tsslCASOSupport.Text = "WARNING:  LINUX AND STEAMOS ARE NOT SUPPORTED!!"
        End If
    End Sub

    Sub readSettings()

        lines = File.ReadAllLines(AWvsSAOSettingsIni)

        '[SCREEN]


        'resolution parse
        Dim xRes As Integer = CInt(lines(1).Substring(6))
        Select Case xRes
            Case 1920
                rb1080p.Checked = True
            Case 2560
                rb1440p.Checked = True
            Case 3840
                rb4K.Checked = True
            Case 7860
                rb8K.Checked = True
        End Select

        'window mode parse
        Dim windowMode As Integer = CInt(lines(3).Substring(5))
        Select Case windowMode
            Case 0
                rbWindowed.Checked = True
            Case 1
                rbBorderless.Checked = True
            Case 2
                rbFullscreen.Checked = True
        End Select

        '[GRAPHICS]


        'FXAA parse
        Dim fxaaSetting As Boolean = CBool(lines(5).Substring(5))
        If fxaaSetting Then
            rbFXXAOn.Checked = True
        Else
            rbFXAAOff.Checked = True
        End If

        'SSAO parse
        Dim ssaoSetting As Boolean = CBool(lines(6).Substring(5))
        If ssaoSetting Then
            rbSSAOOn.Checked = True
        Else
            rbSSAOOff.Checked = True
        End If

        'MSAA parse
        Dim msaaSetting As Integer = CInt(lines(7).Substring(5))
        Select Case msaaSetting
            Case 0
                rbMSAA1x.Checked = True
            Case 1
                rbMSAA2x.Checked = True
            Case 2
                rbMSAA4x.Checked = True
            Case 3
                rbMSAA8x.Checked = True
            Case 4
                rbMSAA16x.Checked = True
        End Select

        'shadow parse
        Dim shadowSetting As Integer = CInt(lines(8).Substring(7))
        Select Case shadowSetting
            Case 0
                rbShadowsOff.Checked = True
            Case 1
                rbShadowsLow.Checked = True
            Case 2
                rbShadowsHigh.Checked = True
        End Select

        'DoF parse
        Dim dofSetting As Boolean = CBool(lines(9).Substring(15))
        If dofSetting Then
            rbDOFOn.Checked = True
        Else
            rbDOFOff.Checked = True
        End If

        'bloom parse, internally known as god rays
        Dim bloomSetting As Boolean = CBool(lines(10).Substring(8))
        If bloomSetting Then
            rbBloomOn.Checked = True
        Else
            rbBloomOff.Checked = True
        End If

        'volumetric parse, internally known as point lights
        Dim volumetricSetting As Boolean = CBool(lines(11).Substring(12))
        If volumetricSetting Then
            rbVolumetricOn.Checked = True
        Else
            rbVolumetricOff.Checked = True
        End If

        'LOD parse
        Dim lodSetting As Integer = CInt(lines(12).Substring(4))
        Select Case lodSetting
            Case 0
                rbLODNear.Checked = True
            Case 1
                rbLODMid.Checked = True
            Case 2
                rbLODFar.Checked = True
        End Select

        'vsync parse
        Dim vsyncSetting As Boolean = CBool(lines(13).Substring(6))
        If vsyncSetting Then
            rbVSyncOn.Checked = True
        Else
            rbVSyncOff.Checked = True
        End If

        '[DISPLAY]


        'skipping this for now?  Not sure which is linked to which


        'adapter parse
        Dim adapterSetting As UInt64 = CULng(lines(17).Substring(8))
        For i As Integer = 0 To results.Count - 1
            If results.Item(i).LUID = adapterSetting Then
                cbGPUs.SelectedIndex = i
            End If
        Next
        'display parse
    End Sub

    Sub populateGPUs()
        Try
            Using directXKey = Registry.LocalMachine.OpenSubKey("SOFTWARE\Microsoft\DirectX")
                For Each subKeyName In directXKey.GetSubKeyNames()
                    Using adapterKey = directXKey.OpenSubKey(subKeyName)
                        If adapterKey Is Nothing Then
                            Continue For
                        End If
                        'Must have AdapterLUID and not be the shader cache or it's something else
                        If (Not adapterKey.GetValueKind("AdapterLuid") = RegistryValueKind.QWord) Or adapterKey.ToString().Contains("ShaderCache") Then
                            Continue For
                        End If

                        Dim desc As String = adapterKey.GetValue("Description")
                        Dim luid As UInt64 = adapterKey.GetValue("AdapterLuid")
                        Dim info As New GPUInfo With {
                            .Description = desc.Trim(),
                            .LUID = luid
                        }
                        results.Add(info)
                        cbGPUs.Items.Add(desc + " (LUID:  " + luid.ToString() + ")")

                    End Using
                Next
            End Using
        Catch ex As Exception
            MsgBox("Error when reading DirectX LUID cache.  Running the launcher as admin may resolve this (keys live in HKLM)" + vbNewLine + vbNewLine + "You can manually edit OptionConfig.ini with your GPU's LUID, however it MUST match the preferred GPU in Windows Settings->Graphics or the game will refuse to boot" + vbNewLine + vbNewLine + "Specific exception:" + vbNewLine + ex.ToString(), MsgBoxStyle.Exclamation + MsgBoxStyle.OkOnly, "Error")
        End Try
    End Sub

    Private Sub cmdLaunchGame_Click(sender As Object, e As EventArgs) Handles cmdLaunchGame.Click
        configure()
        hybridGraphics()
        Process.Start(Environment.CurrentDirectory + "\AWVSSAO.exe")

    End Sub


    Sub hybridGraphics()
        Dim targetGPULUID As String = results(cbGPUs.SelectedIndex()).LUID.ToString()
        lines(17) = "adapter=" + targetGPULUID

        File.WriteAllLines(AWvsSAOSettingsIni, lines)

        Dim appDir As String = Path.GetDirectoryName(Process.GetCurrentProcess().MainModule.FileName)
        Dim psi As New ProcessStartInfo With
        {
            .FileName = "powershell.exe",
            .Arguments = "-NoProfile -ExecutionPolicy Bypass -File .\gpuHelper.ps1 -TargetLuid " & targetGPULUID.ToString(),
            .WorkingDirectory = appDir,
            .UseShellExecute = False,
            .RedirectStandardOutput = True,
            .RedirectStandardError = True,
            .CreateNoWindow = True
        }
        Dim fullValue As String = ";GpuPreference=1073741824;AutoHDREnable=2097;"
        Using p As Process = Process.Start(psi)
            Dim specificAdapter As String = p.StandardOutput.ReadToEnd().Trim()
            Dim errors As String = p.StandardError.ReadToEnd()
            p.WaitForExit()

            If p.ExitCode <> 0 OrElse String.IsNullOrEmpty(specificAdapter) Then
                Throw New Exception("Failed to resolve SpecificAdapter: " & errors)
            End If
            fullValue = specificAdapter + fullValue
        End Using

        'registry for preferred GPU
        'brittle if you install outside default
        Using GPUPrefsKey = Registry.CurrentUser.OpenSubKey("SOFTWARE\Microsoft\DirectX\UserGpuPreferences", True)
            Dim AWvsSAOValue As Object = GPUPrefsKey.GetValue("C:\Program Files (x86)\Steam\steamapps\common\REK\AWVSSAO.exe")
            GPUPrefsKey.SetValue("C:\Program Files (x86)\Steam\steamapps\common\REK\AWVSSAO.exe", fullValue, RegistryValueKind.String)
        End Using
    End Sub

    Sub configure()
        If rb1080p.Checked Then
            lines(1) = "width=1920"
            lines(2) = "height=1080"
        ElseIf rb1440p.Checked Then
            lines(1) = "width=2560"
            lines(2) = "height=1440"
        ElseIf rb4K.Checked Then
            lines(1) = "width=3840"
            lines(2) = "height=2160"
        ElseIf rb8K.Checked Then
            lines(1) = "width=7860"
            lines(2) = "height=4320"
        Else
            'never here?  wierd or ultrawide mods?
        End If

        'experimenting with alternate way to keep this function clean
        'Vibe coded by Gemini 3.5 Flash-Lite

        lines(5) = "fxaa=" + GetSelectedTag(gbFXAA)
        lines(6) = "ssao=" + GetSelectedTag(gbSSAO)
        lines(7) = "msaa=" + GetSelectedTag(gbMSAA)
        lines(8) = "shadow=" + GetSelectedTag(gbShadows)
        lines(9) = "depth_of_field=" + GetSelectedTag(gbDepthOfField)
        lines(10) = "god_ray=" + GetSelectedTag(gbBloom)
        lines(11) = "point_light=" + GetSelectedTag(gbVolumetricLighting)
        lines(12) = "lod=" + GetSelectedTag(gbLevelOfDetail)
        lines(13) = "vsync=" + GetSelectedTag(gbVSync)
    End Sub

    ' Helper function to get the Tag of the checked RadioButton in any container
    'Vibe coded by Gemini 3.5 Flash-Lite
    Private Function GetSelectedTag(container As Control) As String
        Dim checkedBtn = container.Controls.OfType(Of RadioButton)().FirstOrDefault(Function(r) r.Checked)
        If checkedBtn IsNot Nothing AndAlso checkedBtn.Tag IsNot Nothing Then
            Return checkedBtn.Tag.ToString()
        End If
        Return String.Empty
    End Function

End Class

Public Class GPUInfo
    Public Property Description As String

    Public Property LUID As UInt64
End Class